# Firebase web app config (Project settings → Your apps → Web app)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_SENDER_ID=
VITE_FB_APP_ID=
# App Check: reCAPTCHA Enterprise site key (score-based) for the deployed site
VITE_RECAPTCHA_KEY=
# For local development, put the App Check debug token in .env.development.local
# (never in .env, so it is never part of a production build):
# VITE_APPCHECK_DEBUG_TOKEN=
